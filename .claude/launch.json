{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "monitorpro",
      "runtimeExecutable": ".venv\\Scripts\\python.exe",
      "runtimeArgs": ["manage.py", "runserver", "127.0.0.1:8000"],
      "port": 8000,
      "url": "http://127.0.0.1:8000"
    },
    {
      "name": "monitorpro-demo",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "set DB_NAME=monitorpro_demo&& set DEBUG=True&& .venv\\Scripts\\python.exe manage.py runserver 127.0.0.1:8001"],
      "port": 8001,
      "url": "http://127.0.0.1:8001"
    }
  ]
}
