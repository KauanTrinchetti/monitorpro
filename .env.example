# ==========================================================
# Modelo de configuracao. Copie para .env e preencha.
# O .env NUNCA deve ser versionado (ja esta no .gitignore).
# ==========================================================

# --- Django ---
# Gere com: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=seudominio.com.br,www.seudominio.com.br
CSRF_TRUSTED_ORIGINS=https://seudominio.com.br,https://www.seudominio.com.br

# Marque como True somente quando a aplicacao estiver atras de um proxy
# reverso (nginx, Cloudflare, Render) que reescreve X-Forwarded-For.
# Se ficar True sem proxy, o rate limit vira burlavel por header forjado.
ATRAS_DE_PROXY_CONFIAVEL=False

# --- Banco de dados ---
DB_NAME=sistema_prestadores
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# --- E-mail transacional do painel ---
DEFAULT_FROM_EMAIL=alertas@seudominio.com.br
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.seudominio.com.br
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# --- Robo leitor de faturas (IMAP) ---
EMAIL_CONTA=
SENHA_APP=
EMAIL_DESTINO=

# --- Webhook de WhatsApp ---
# Precisa ser https:// e apontar para host publico.
# Enderecos privados/loopback sao bloqueados (protecao contra SSRF).
WHATSAPP_WEBHOOK_URL=

# --- Limites do pipeline de PDF ---
PDF_TAMANHO_MAXIMO_MB=25
PDF_PAGINAS_MAXIMAS=150
PDF_TIMEOUT_SEGUNDOS=120
